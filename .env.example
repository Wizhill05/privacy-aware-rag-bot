# Application Port & Mode
PORT=3000
NODE_ENV=development
AUTH_MODE=mock # 'mock' or 'auth0'

# Session Secret (random 32+ char string)
SESSION_SECRET=a_very_long_random_session_secret_change_me_in_production_123456

# Auth0 Universal Login Configuration (Required if AUTH_MODE=auth0)
# Found under Auth0 Dashboard > Applications > Applications > [Your App]
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret

# Auth0 FGA / OpenFGA Configuration (Optional for offline mock evaluator)
# If provided, connects to real Auth0 FGA instance. If omitted/offline, uses built-in evaluator.
FGA_API_URL=https://api.us1.fga.dev
FGA_STORE_ID=your_fga_store_id
FGA_CLIENT_ID=your_fga_client_id
FGA_CLIENT_SECRET=your_fga_client_secret
FGA_API_AUDIENCE=https://api.us1.fga.dev/
FGA_API_TOKEN_ISSUER=auth.fga.dev
